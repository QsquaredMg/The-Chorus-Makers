# Copy to .env.local for local development. Set the same values in Vercel
# (Project Settings > Environment Variables). Never commit real keys.

# Public site URL, used for Stripe return links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.thechorusmakers.com

# Supabase (project nqofykoiphimzsucixtl)
NEXT_PUBLIC_SUPABASE_URL=https://nqofykoiphimzsucixtl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Use sk_test_ / whsec_ values while testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase publishable key (safe for the browser; used by /admin sign-in)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Admin: comma-separated emails allowed to sign in to /admin
ADMIN_EMAILS=

# Push notifications to your phone via the ntfy app (choose a long random topic)
NTFY_TOPIC=

# Client emails via Resend (verified sender)
RESEND_API_KEY=
RESEND_FROM=
